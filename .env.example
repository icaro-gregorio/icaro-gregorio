# Firebase Web App configuration.
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
#
# All Vite client-side env vars MUST be prefixed with VITE_ to be exposed to the app.
# These values are safe to ship in a client bundle; access is controlled by Firestore
# security rules (see firestore.rules), NOT by keeping this key secret.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "true" to point the app at local Firebase emulators (see `npm run emulators`).
VITE_USE_FIREBASE_EMULATORS=false
